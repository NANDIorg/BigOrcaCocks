{
  "name": "@orca-board/desktop",
  "version": "0.0.2",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-vite build && electron-builder --mac --dir && electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --mac && electron-builder install-app-deps",
    "dist:mac": "electron-vite build && electron-builder --mac && electron-builder install-app-deps",
    "dist:win": "electron-vite build && electron-builder --win --config.npmRebuild=false && electron-builder install-app-deps",
    "test": "node --experimental-transform-types --no-warnings --import ./test/ts-resolve.mjs --test src/main/*.test.ts"
  },
  "dependencies": {
    "@orca-board/core": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "description": "Оркестратор CLI-агентов с канбан-доской",
  "author": "nandi"
}
