{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "electron-vite/node"
    ],
    "paths": {
      "@orca-board/core": [
        "../../packages/core/src/index.ts"
      ],
      "@orca-board/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
