# Публичные адреса панели и preview: два разных hostname, оба через HTTPS reverse proxy.
ORCA_ORIGIN=https://orca.example.com
ORCA_PREVIEW_ORIGIN=https://orca-preview.example.com

# Первый оператор создаётся при первом запуске, если аккаунтов ещё нет. Пароль — минимум 12 символов.
# После первого запуска переменные можно удалить: аккаунты хранятся в томе orca-home.
ORCA_ADMIN_LOGIN=admin
ORCA_ADMIN_PASSWORD=

# Каталог проектов на хосте, монтируется в /projects.
ORCA_PROJECTS_DIR=./projects

# Порты на хосте для reverse proxy. ORCA_BIND=0.0.0.0 нужен, только если proxy на другой машине.
ORCA_BIND=127.0.0.1
ORCA_PANEL_PORT=8080
ORCA_PREVIEW_PORT=8081
